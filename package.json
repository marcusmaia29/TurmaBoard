{
  "name": "turmaboard",
  "private": true,
  "version": "0.1.0",
  "description": "A shared academic board for class deadlines, schedules, and course resources.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcusmaia29/TurmaBoard.git"
  },
  "bugs": {
    "url": "https://github.com/marcusmaia29/TurmaBoard/issues"
  },
  "homepage": "https://github.com/marcusmaia29/TurmaBoard#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "npm run lint -- --max-warnings=0 && npm test && npm run build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "types:generate": "supabase gen types typescript --local > src/lib/database.generated.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.102.3",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^0.534.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "supabase": "^2.115.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
